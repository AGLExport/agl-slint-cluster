[Unit]
Description=Slint instrument cluster

[Service]
# Render straight to KMS/DRM with no compositor. On AGL, seamless boot-splash
# handover (drm-lease-manager) is added when packaging the image; this generic
# unit just takes the display directly.
Environment=SLINT_BACKEND=linuxkms
Environment=SLINT_FULLSCREEN=1
# Signals come from the built-in simulation unless a source is named: a CAN
# bus (CLUSTER_SOURCE=can:can0, see docs/can.md), the Kuksa databroker
# (CLUSTER_SOURCE=kuksa, see docs/kuksa.md) or an OBD-II dongle
# (CLUSTER_SOURCE=obd:bt:<address>, see docs/obd.md).
# AGL's broker needs TLS and a token with the read scope:
#Environment=CLUSTER_SOURCE=kuksa:https://127.0.0.1:55555
#Environment=KUKSA_TLS_SERVER_NAME=localhost
#Environment=KUKSA_CA_CERT=/etc/kuksa-val/CA.pem
#Environment=KUKSA_TOKEN_FILE=/etc/xdg/AGL/agl-slint-cluster/agl-slint-cluster.token
ExecStart=/usr/bin/agl-slint-cluster
Restart=on-failure
RestartSec=2
# It ships without systemd sandboxing (ProtectSystem, NoNewPrivileges, ...);
# add those for a production image.

[Install]
WantedBy=multi-user.target
